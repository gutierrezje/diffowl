{
  "name": "diffowl",
  "version": "0.4.0",
  "description": "Local AI code review agent for OpenCode and Codex",
  "keywords": [
    "ai",
    "code-review",
    "codex",
    "git",
    "opencode",
    "pre-commit"
  ],
  "homepage": "https://github.com/gutierrezje/diffowl#readme",
  "bugs": {
    "url": "https://github.com/gutierrezje/diffowl/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gutierrezje/diffowl.git"
  },
  "bin": {
    "diffowl": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "prebuild": "pnpm run check:runtime",
    "build": "tsup",
    "predev": "pnpm run check:runtime",
    "dev": "tsup --watch",
    "pretest": "pnpm run check:runtime",
    "test": "vitest run",
    "pretypecheck": "pnpm run check:runtime",
    "typecheck": "node scripts/typecheck.mjs --noEmit",
    "build:anti-slop": "tsup --entry.plugin tools/oxlint/anti-slop/index.ts --format esm --target node22 --external @oxlint/plugins --out-dir tools/oxlint/anti-slop --no-config --silent",
    "check:anti-slop": "pnpm run build:anti-slop && git diff --exit-code HEAD -- tools/oxlint/anti-slop/plugin.js",
    "lint": "pnpm run check:anti-slop && oxlint . --max-warnings 366 && pnpm run typecheck",
    "test:codex": "vitest run src/codex",
    "spike:codex:test": "vitest run src/codex src/experiments/codex-app-server",
    "spike:codex:protocol-live": "vitest run src/codex/protocol-evidence.test.ts",
    "spike:codex:live": "vitest run src/experiments/codex-app-server/live.integration.test.ts",
    "spike:codex:matched": "vitest run src/experiments/codex-app-server/matched.integration.test.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "eval": "pnpm run build && node dist/cli.js eval",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.15.11",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "ora": "^9.4.0",
    "picomatch": "^4.0.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^25.9.1",
    "@types/picomatch": "^4.0.3",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.15.1"
}
